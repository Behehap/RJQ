cat > .gitignore << 'EOF'
# Binaries
rjq
rjq.exe
cmd/server/server

# Databases
*.db
*.sqlite
*.sqlite3

# Environment
.env
.env.local

# Build and test artifacts
results/
experiments/results/
bin/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Go workspace
go.work
go.work.sum
EOF